### Profiles.

# What the profile made from git's identity is called, the first time the profiles are read.
profiles-default-name = Default

## The table of profiles in the preferences.

# The button over the table, and the title of the dialog it opens.
profiles-add = Add a profile
profiles-profile-name = Profile name
profiles-author-name = Author name
profiles-author-email = Author email
profiles-keys = Keys
# What a profile has besides a name and an address; the parts are put together with a dot between.
profiles-signs-ssh = signs with SSH
profiles-signs-certificate = signs with a certificate
profiles-signs-gpg = signs with GPG
profiles-own-ssh-key = own SSH key
profiles-menu = Menu of the profile
profiles-use-everywhere = Use everywhere
profiles-use-here = Use here only
profiles-change = Change…
profiles-delete = Delete…

## The dialog that makes a profile or changes one.

profiles-dialog-change = Change the profile
profiles-name-placeholder = New profile
profiles-signing-key = Signing key
profiles-signing-key-placeholder = a GPG key id or an SSH public key file (optional)
profiles-ssh-key = SSH key file
profiles-ssh-key-placeholder = an SSH private key file to connect with (optional)
profiles-name-taken = There is a profile of that name already.
profiles-author-name-invalid = A name to commit as cannot hold < or >.
profiles-author-email-invalid = An address holds no blanks and no < or >.
profiles-copy-current = Take the current profile's settings
profiles-cancel = Cancel
profiles-dialog-add-button = Add
profiles-dialog-save = Save
# $why is what the engine said.
profiles-workspaces-not-renamed = The workspaces that name the profile by its old name still do: { $why }
