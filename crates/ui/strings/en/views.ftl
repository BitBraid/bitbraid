### What several views share.

## How long ago something was, in short.

# A time later than the clock says now.
views-in-the-future = in the future
views-just-now = just now
views-minutes-ago = { $count } min ago
views-hours-ago = { $count } h ago
views-days-ago = { $count } d ago
views-months-ago = { $count } mo ago
views-years-ago = { $count } y ago

## Files and folders dragged by their paths.

# The chip that follows the pointer, when more than one is dragged.
views-dragged-files = { $count } files
