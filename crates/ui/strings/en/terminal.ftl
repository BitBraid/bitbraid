### The terminal.

## The heading of the panel.

terminal-heading = Terminal
# A terminal's tab while its shell has not given it a title. $number counts the terminals started.
terminal-tab-name = Terminal { $number }
terminal-tab-close = Close this terminal
terminal-new = Start another terminal here
# The button that brings a terminal folded to its heading back.
terminal-restore = Show the terminal whole
# The button that folds the terminal to its heading.
terminal-minimise = Keep only this heading
terminal-end = End this shell
terminal-hide = Put the terminal away; its shell keeps running

## The menu over the text.

terminal-menu-copy = Copy
terminal-menu-paste = Paste
terminal-menu-select-all = Select All
terminal-menu-delete-line = Delete Line
terminal-menu-clear = Clear
terminal-menu-minimise = Minimise
terminal-menu-end = End the session
terminal-menu-hide = Hide

## Starting a shell.

# $program is the shell, $error the system's reason.
terminal-cannot-start = { $program } could not be started: { $error }
