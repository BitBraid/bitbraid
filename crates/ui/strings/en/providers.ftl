### Providers, as the window asks them.

## The sites an account can be at.

providers-site-github = GitHub
providers-site-github-server = GitHub Enterprise Server
providers-site-gitlab = GitLab
providers-site-gitlab-server = GitLab Self-Managed

## The address of a server of one's own, as it was typed.

providers-address-empty = Type the address of the server first.
providers-address-invalid = That is not the address of a server.
providers-address-plain-http = A server is spoken to over HTTPS: plain HTTP only to this machine.
providers-address-scheme = A server's address begins with https://.

## What a provider command said.

# A parameter the command would not take: $name is the parameter, $why the engine's reason.
providers-invalid-parameter = the { $name } { $why }
# $id is the command, $error what was wrong with its answer.
providers-answer-unreadable = The answer to { $id } could not be read ({ $error }).
providers-no-answer = The command ended without an answer.

## Accounts.

# An account at a site of its own address: $login is the account's name, $host the site's host.
providers-account-at = { $login } at { $host }
