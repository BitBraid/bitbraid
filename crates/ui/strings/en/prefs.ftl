### Preferences as they are read and written.

## The graph's columns, as menus and headings name them.

# The column with each commit's message.
prefs-column-summary = Summary
prefs-column-author = Author
prefs-column-date = Date
# The column with each commit's short id.
prefs-column-id = Id

## The choices of the preferences' lists.

# The shapes of the terminal's cursor.
prefs-cursor-bar = Bar
prefs-cursor-block = Block
prefs-cursor-underline = Underline
# What Tab does while completions are on show.
prefs-tab-shell = Goes to the shell
prefs-tab-accept = Takes the one marked
prefs-tab-next = Marks the next one
# The orders the graph can be in.
prefs-order-date = By date, newest first
prefs-order-author = By the date each change was written, newest first
prefs-order-topo = Each line of history together
# The dates a row of the graph can show.
prefs-date-author = When the change was written (author date)
prefs-date-commit = When the commit was made (commit date)

## A file of ours that cannot be read, said once there is a window.

# Why the file cannot be read.
prefs-not-text = it is not text
# name is the file's name, error why it cannot be read, kept the path it
# was moved to.
prefs-unreadable-kept = { $name } could not be read ({ $error }). It was kept as { $kept } and the defaults are in use.
prefs-unreadable-not-moved = { $name } could not be read ({ $error }) and could not be moved aside; the defaults are in use and will be written over it.
