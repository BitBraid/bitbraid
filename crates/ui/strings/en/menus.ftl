### The application's menus.

## The menu bar of macOS. Its menus and entries are written in title case,
## as the menus of macOS are.

menus-file = File
menus-edit = Edit
menus-view = View
menus-repository = Repository
menus-window = Window
menus-help = Help

## The application's menu, which has the product's name.

menus-about = About { -product }
menus-settings = Settings…
# Also in Help.
menus-keyboard-shortcuts = Keyboard Shortcuts
# The system's own submenu.
menus-services = Services
menus-hide = Hide { -product }
menus-hide-others = Hide Others
menus-show-all = Show All
menus-quit = Quit { -product }

## File.

menus-new-tab = New Tab
menus-open-repository = Open Repository…
menus-clone-repository = Clone Repository…
menus-new-repository = New Repository…
menus-repositories-and-workspaces = Repositories and Workspaces
menus-close-tab = Close Tab

## Edit: what the text field that has the keys does.

menus-undo = Undo
menus-redo = Redo
menus-cut = Cut
menus-copy = Copy
menus-paste = Paste
menus-select-all = Select All
menus-find = Find…

## View.

# Also in Help.
menus-command-palette = Command Palette…
menus-references-panel = References Panel
menus-details-panel = Details Panel
menus-terminal = Terminal
menus-activity-log = Activity Log
menus-undo-history = Undo History
menus-notifications = Notifications
menus-next-theme = Next Theme
menus-zoom-in = Zoom In
menus-zoom-out = Zoom Out
menus-actual-size = Actual Size

## Repository.

menus-fetch = Fetch
menus-pull = Pull
menus-push = Push
menus-new-branch = New Branch…
menus-stash-changes = Stash Changes…
menus-pop-stash = Pop Stash
# The last git action, not typing.
menus-undo-last-action = Undo Last Action
menus-redo-last-action = Redo Last Action
# The repository's folder in the file manager (Finder on macOS).
menus-show-in-finder = Show in Finder
menus-open-in-terminal = Open in Terminal
menus-open-in-editor = Open in Editor
menus-refresh = Refresh

## Window.

menus-minimize = Minimize
# Make the window as large as it goes, and back.
menus-zoom = Zoom
menus-show-next-tab = Show Next Tab
menus-show-previous-tab = Show Previous Tab
