### Submodules.

## The menu entries about all submodules.

submodules-add = Add a submodule…
submodules-update-all = Update all
submodules-sync-all = Sync all URLs

## The menu entries of a submodule.

submodules-update = Update to the recorded commit
# For a submodule that is not cloned yet.
submodules-clone = Clone and check out
submodules-open-in-tab = Open in a new tab
submodules-open-in-tab-not-there = Open in a new tab (it is not checked out)
submodules-remove = Remove…
submodules-sync = Sync URL

## What a submodule's state is called beside its name.

submodules-state-not-there = not checked out
submodules-state-conflicted = in conflict
# What it has checked out is not what the superproject records.
submodules-state-moved = moved
# It has changes of its own.
submodules-state-changed = changed
